# ── Lakebase ────────────────────────────────────────────────────────────────
# Option A (recommended) — paste the full connection string from
# Instance → Connect → Connection string. Leave the password out; a
# short-lived OAuth token is injected automatically at connect time.
LAKEBASE_URL=postgresql://shantanukhond%40outlook.com@ep-delicate-rice-token.database.us-east-2.cloud.databricks.com/databricks_postgres?sslmode=require

# Option B — discrete fields (used only if LAKEBASE_URL is not set)
LAKEBASE_HOST=instance-xxxxxxxx.database.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=dwh_course

# The Lakebase *instance name* (not the hostname) — Instance list page, e.g.
# "dwh-course". Needed to mint the short-lived Postgres credential.
LAKEBASE_INSTANCE_NAME=dwh-course

# ── Databricks workspace auth (Personal Access Token) ───────────────────────
# Workspace URL: https://<your-workspace>.cloud.databricks.com  (no trailing /)
# Token: User Settings → Developer → Access tokens → Generate new token
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi.................................

# Optional — your Databricks login email. If omitted, it's resolved from the
# token automatically.
# DATABRICKS_USER=you@example.com
